{
  "name": "threat-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check:budgets": "node scripts/check-budgets.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "profile:startup": "node scripts/profile-startup.mjs",
    "test:e2e:cross": "playwright test --config playwright.cross.config.ts",
    "verify:crash": "node scripts/verify-crash.mjs",
    "verify:history": "node scripts/verify-save-history.mjs",
    "verify:campaign": "node scripts/verify-campaign.mjs",
    "verify:guidance": "node scripts/verify-guidance.mjs",
    "verify:journey": "node scripts/verify-journey.mjs",
    "verify:comparison": "node scripts/verify-comparison.mjs",
    "verify:expansion": "node scripts/verify-expansion.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "dexie": "4.4.6",
    "howler": "2.2.4",
    "motion": "14.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/howler": "2.2.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
